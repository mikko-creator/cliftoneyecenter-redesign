# 404 page (dist/404.html; its URLs are root-relative, COMPONENTS F.7)
ErrorDocument 404 /404.html

# Carried-forward redirects (see audit/redirects.json)
RedirectMatch 301 ^/eye-care-services/dry-eye-disease-and-treatment/?$ /eye-care-services/eye-conditions/dry-eye-disease-and-treatment/
RedirectMatch 301 ^/eye-care-services/pediatric-eye-exams/?$ /eye-care-services/eye-exams/pediatric-eye-exams/
RedirectMatch 301 ^/eyeglasses-contacts/designer-frames/?$ /eyeglasses-contacts/eyeglasses/designer-frames/
RedirectMatch 301 ^/eyeglasses/designer-frames/?$ /eyeglasses-contacts/eyeglasses/designer-frames/
RedirectMatch 301 ^/your-eye-health/eye-conditions/?$ /eye-care-services/eye-conditions/
RedirectMatch 301 ^/your-eye-health/eye-diseases/?$ /eye-care-services/your-eye-health/eye-diseases/
RedirectMatch 301 ^/your-eye-health/eye-diseases/cataracts/?$ /eye-care-services/your-eye-health/eye-diseases/cataracts/
RedirectMatch 301 ^/your-eye-health/eye-diseases/macular-degeneration/?$ /eye-care-services/your-eye-health/eye-diseases/macular-degeneration/
RedirectMatch 301 ^/your-eye-health/protecting-your-eyes/?$ /eye-care-services/your-eye-health/protecting-your-eyes/
